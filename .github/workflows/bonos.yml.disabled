name: Sistema de Inversión Automático - Renta Fija (Bonos)

on:
  schedule:
    # 12:30 UTC = 07:30 AM en Hora de Colombia (UTC-5)
    - cron: '30 12 * * *'
  workflow_dispatch:

jobs:
  run-bot-bonos:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout del repositorio
        uses: actions/checkout@v4
        
      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
          cache: 'pip' # Activar cache de pip por velocidad
          
      - name: Instalar dependencias
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          
      - name: Ejecutar script de reporte Bonos
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          CHAT_ID: ${{ secrets.CHAT_ID }}
        run: python reporte_bonos.py
